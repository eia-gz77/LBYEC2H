@article{6,
issn = {2331-8422},
journal = {arXiv.org},
keywords = {Gravitational waves ;  Coherence ;  Consistency ;  Consistency tests ;  Gamma ray bursts ;  Gamma rays ;  Noise ;  Normal distribution ;  Random noise ;  Searching},
language = {eng},
copyright = {2010. This work is published under http://arxiv.org/licenses/nonexclusive-distrib/1.0/ (the “License”). Notwithstanding the ProQuest Terms and Conditions, you may use this content in accordance with the terms of the License.},
publisher = {Cornell University Library, arXiv.org},
title = {A targeted coherent search for gravitational waves from compact binary coalescences},
year = {2010},
abstract = {We present the details of a method for conducting a targeted, coherent search for compact binary coalescences. The search is tailored to be used as a followup to electromagnetic transients such as Gamma Ray Bursts. We derive the coherent search statistic for Gaussian detector noise and discuss the benefits of a coherent, multi-detector search over coincidence methods. To mitigate the effects of non-stationary data, we introduce a number of signal consistency tests, including the null SNR, amplitude consistency and several \(\chi^{2}\) tests. We demonstrate the search performance on Gaussian noise and on data from LIGO's fourth science run and verify that the signal consistency tests are capable of removing the majority of noise transients and the search gives an efficiency comparable to that achieved in Gaussian noise.},
author = {Harry, Ian and Fairhurst, Stephen},
address = {Ithaca},
}

@article{7,
issn = {2367-3613},
journal = {Living reviews in relativity},
keywords = {Binary stars ;  Binary systems ;  AM CVn stars ;  Astronomy ;  Astrophysics ;  Astrophysics and Astroparticles ;  Black holes ;  Classical and Quantum Gravitation ;  Cosmology ;  Gravitational waves ;  Gravitational-wave sources ;  Massive stars ;  Neutron stars ;  Physics ;  Progenitors (astrophysics) ;  Relativity Theory ;  Review ;  Review Article ;  Stellar evolution ;  Stellar system evolution ;  Stellar systems ;  Supernovae ;  White dwarf stars ;  White dwarfs},
language = {eng},
number = {1},
copyright = {The Author(s) 2014},
pages = {3-},
publisher = {Springer International Publishing},
title = {The Evolution of Compact Binary Star Systems},
volume = {17},
year = {2014},
abstract = {We review the formation and evolution of compact binary stars consisting of white dwarfs (WDs), neutron stars (NSs), and black holes (BHs). Mergings of compact-star binaries are expected to be the most important sources for forthcoming gravitational-wave (GW) astronomy. In the first part of the review, we discuss observational manifestations of close binaries with NS and/or BH components and their merger rate, crucial points in the formation and evolution of compact stars in binary systems, including the treatment of the natal kicks, which NSs and BHs acquire during the core collapse of massive stars and the common envelope phase of binary evolution, which are most relevant to the merging rates of NS-NS, NS-BH and BH-BH binaries. The second part of the review is devoted mainly to the formation and evolution of binary WDs and their observational manifestations, including their role as progenitors of cosmologically-important thermonuclear SN Ia. We also consider AM CVn-stars, which are thought to be the best verification binary GW sources for future low-frequency GW space interferometers.},
author = {Postnov, Konstantin A. and Yungelson, Lev R.},
address = {Cham},
}

@article{8,
issn = {0018-9219},
journal = {Proceedings of the IEEE},
keywords = {Digital filters ;  Chebyshev approximation ;  Circuit theory ;  Circuits and systems ;  Electrons ;  Filtering theory ;  Finite impulse response filter ;  Gold ;  Image processing ;  Quantization},
language = {eng},
number = {4},
pages = {595-610},
publisher = {IEEE},
title = {FIR digital filter design techniques using weighted Chebyshev approximation},
volume = {63},
year = {1975},
abstract = {This paper discusses the various approaches to designing FIR digital filters using the theory of weighted Chebyshev approximation. The different design techniques are explained and compared on the basis of their capabilities and limitations. The relationships between filter parameters are briefly discussed for the case of low-pass filters. Extensions of the theory to the problems of magnitude and complex approximation are also included, as are some recent results on the design of two-dimensional FIR filters by transformation.},
author = {Rabiner, L.R. and McClellan, J.H. and Parks, T.W.},
}

